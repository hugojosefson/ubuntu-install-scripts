{
  "exports": { "./cli": "./src/cli.ts" },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/fs": "jsr:@std/fs@^1.0.22",
    "@std/path": "jsr:@std/path@^1.1.3",
    "@hugojosefson/run-simple": "jsr:@hugojosefson/run-simple@^2.4.0",
    "dependency-graph": "npm:dependency-graph@^1.0.0"
  },
  "tasks": {
    "fmt": "deno fmt",
    "format": "deno fmt --check",
    "lint": "deno lint src test",
    "typecheck": "deno check --frozen src/cli.ts test/*.ts",
    "test": "deno test --frozen --allow-read --allow-write --allow-run --allow-env test",
    "check": "deno task format && deno task lint && deno task typecheck && deno task test",
    "plan": "deno run --frozen --allow-read --allow-env src/cli.ts plan"
  },
  "fmt": {
    "include": ["src", "test", "docs", "README.md", "deno.json", ".github"]
  },
  "lock": { "frozen": true }
}
