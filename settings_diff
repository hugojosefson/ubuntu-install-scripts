#!/usr/bin/env bash
# Observe desktop changes. This command never applies configuration.
set -euo pipefail
database=${1:-}
case "$database" in
    gsettings|dconf) ;;
    *) printf 'Usage: %s <gsettings | dconf>\n' "$0" >&2; exit 2 ;;
esac
snapshot() {
    if [[ "$database" == dconf ]]; then
        dconf dump /
    else
        gsettings list-recursively | sort -u
    fi
}
previous=$(snapshot)
printf '%s\n' 'Change desktop configuration, then press ENTER to show the difference. Ctrl-C exits.' >&2
while read -r; do
    current=$(snapshot)
    status=0
    diff --unified=3 <(printf '%s\n' "$previous") <(printf '%s\n' "$current") || status=$?
    [[ "$status" -le 1 ]] || exit "$status"
    previous=$current
done
